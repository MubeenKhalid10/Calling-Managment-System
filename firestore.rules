rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /leads/{leadId} {
      allow read: if true;
      allow write: if isValidId(leadId);
    }

    match /callLogs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId);
      allow delete: if true;
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
